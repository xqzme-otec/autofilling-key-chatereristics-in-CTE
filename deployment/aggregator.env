# Aggregator (backend) settings, loaded by docker-compose.yaml. No secrets here.
# Defaults for a local `go run` live in backend/aggregator-service/internal/config/config.go.

# Log level: debug, info, warn, error.
LOG_LEVEL=info

# HTTP server; changing the port also requires changing `ports` in docker-compose.yaml.
LISTEN_ADDR=:8000
# Keep under stop_grace_period of the backend in docker-compose.yaml (10 s).
SHUTDOWN_TIMEOUT_S=8
READ_HEADER_TIMEOUT_S=10
# Request body limit, bytes (1 MiB).
MAX_BODY_BYTES=1048576
# Comma-separated frontend origins.
CORS_ORIGINS=*

# Model service.
MODEL_SERVICE_URL=http://model:8001
MODEL_TIMEOUT_S=30
MAX_TEXT_LENGTH=2000
# Table upload (POST /api/v1/analyze/batch): products per file and how many are analyzed at once.
# The file itself is limited by MAX_BODY_BYTES.
MAX_BATCH_ITEMS=50
BATCH_CONCURRENCY=4

# Redis sessions.
REDIS_URL=redis://redis:6379/0
REDIS_PING_TIMEOUT_S=5
REDIS_OP_TIMEOUT_S=3
SESSION_TTL_S=3600
